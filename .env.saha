# ============================================================
#  GateGuard — SAHA (PROD) .env
#  Donanım: Intel i5-8250U (4çek/8thr, 1.6GHz) · 12GB RAM · CPU-only build
#  Kurulumda: bu dosyayı  C:\GateGuard\.env  olarak kopyala (adı ".env" olacak).
#  <<< DOLDUR >>> yazan yerleri kendi bilgilerinle değiştir.
# ============================================================

# ── Çalışma modu ────────────────────────────────────────────
# false = CANLI (gerçek kamera + MDB + ESP32). Kurulumda MUTLAKA false.
MOCK_MODE=false

# ── Plaka/Bariyer Kamerası (tek stream) ─────────────────────
# Bariyerdeki plaka kamerasının RTSP adresi. Diğer 7 kamerayı BURAYA yazma —
# onları web arayüzünden (/admin → Kamera Ekle) ekleyeceksin.
# Dahua örnek : rtsp://admin:SIFRE@192.168.1.100:554/cam/realmonitor?channel=1&subtype=0
# Hikvision   : rtsp://admin:SIFRE@192.168.1.100:554/Streaming/Channels/101
# İPUCU: "bağlanıyor ama görüntü yok" olursa ana stream H.265'tir → SUB-stream kullan
#        (Dahua subtype=1, Hikvision .../Channels/102).
RTSP_URL=rtsp://admin:SIFRE@192.168.1.100:554/cam/realmonitor?channel=1&subtype=0   # <<< DOLDUR >>>

# Plaka kamerasında saniyede işlenecek kare. Zayıf CPU + 7 hırsızlık kamerası ile
# paylaşımlı çalıştığı için 5 yerine 3. Araçlar hızlı giriyorsa 4-5'e çıkarabilirsin.
PROCESS_FPS=3
# Giriş/çıkış yönü: plaka BÜYÜYORSA giriş = "approach" (bariyer dışarı bakıyorsa)
#                  plaka KÜÇÜLÜYORSA giriş = "recede"  (kamera içeriden girişe bakıyor / rampa)
CAMERA_ENTRY_SIZE_CHANGE=recede         # <<< sahada gözle doğrula, gerekirse approach yap >>>
CAMERA_ENTRY_Y_DIRECTION=down
CONFIDENCE_THRESHOLD=0.45
ALARM_COOLDOWN_SEC=10
LPR_ENGINE=fast_alpr
# Plaka dedektör çözünürlüğü: düşük = kenar karakteri kırpabilir (34GPF89 gibi).
# 512 iyi denge (CPU). Hâlâ kırpıyorsa 640 dene (daha yavaş). İlk açılışta iner.
#   yolo-v9-t-256/384/416/512/640-license-plate-end2end  |  yolo-v9-s-608-... (en iyi)
ALPR_DETECTOR_MODEL=yolo-v9-t-512-license-plate-end2end
ALPR_OCR_MODEL=cct-s-v2-global-model

# ── ESP32 Siren (opsiyonel donanım) ─────────────────────────
# ESP32 siren modülü VARSA IP'sini yaz + ALARM_SIREN_ENABLED=true.
# YOKSA: ALARM_SIREN_ENABLED=false yap → sistem yazılımsal çalışır, ekranda alarm
# yine görünür, sadece fiziksel siren çalmaz ve "siren yok" uyarısı çıkmaz.
ESP32_IP=                # <<< DOLDUR (yoksa boş bırak) >>>
ALARM_SIREN_ENABLED=false               # <<< ESP32 varsa true yap >>>

# ── Moonwell MDB (AĞDAKI PAYLAŞIMLI PC) ─────────────────────
# Moonwell veritabanı başka bir PC'de paylaşımda. UNC yolu kullan (\\PC-ADI\...).
# Eşlenmiş sürücü harfi (Z:\) KULLANMA — servis/oturum o harfi göremez.
#   Örnek: \\MOONWELL-PC\paylasim\MoonWell MW-305 V2.11\MW305_DB200.mdb
# DİKKAT:
#   • GateGuard'ı bu paylaşımı OKUYABİLEN bir Windows kullanıcı hesabıyla çalıştır
#     (Windows servisi "Local System" ağ paylaşımına erişemez → kullanıcı hesabı seç).
#   • Moonwell PC'sinde klasörü Paylaş → bu PC'nin hesabına en az OKUMA izni.
#   • Microsoft Access Database Engine 2016 (64-bit) bu PC'de kurulu olmalı.
MDB_PATH=\\MOONWELL-PC\paylasim\MW305_DB200.mdb   # <<< DOLDUR (gerçek PC adı + yol) >>>
# Ağdaki .mdb'yi açmadan önce yerel geçici kopyaya al (paylaşım için ÖNERİLİR;
# .ldb kilit sorununu ve anlık ağ kopmalarını önler, sadece OKUMA izni yeter).
MDB_COPY_LOCAL=true

# Yerel SQLite (ilk açılışta otomatik oluşur, dokunma)
SQLITE_PATH=data/gateguard.db

# ── Modül 2: Hırsızlık / Gece İzleme (7 kamera) ─────────────
ENABLE_INTRUSION_MODULE=true
# İLK HAFTA true bırak: siren çalmadan sadece olay kaydeder → yanlış alarmları
# görüp bölgeleri/ayarları düzeltirsin, sonra false yapıp canlıya geçersin.
INTRUSION_SHADOW_MODE=true
NIGHT_MODE_START=22:00
NIGHT_MODE_END=07:00

# --- CPU-only performans (i5-8250U için ayarlandı) ---
# 7 kamerayı zayıf CPU'da döndürmek için kamera başına saniyede 1 kare.
INTRUSION_PROCESS_FPS=1
# Önemli kameralara 2 fps vermek istersen (kamera ID'leri UI'da belli olunca):
#   Örnek "1:2,5:2"  → 1 ve 5 no'lu kamera 2 fps, gerisi global (1). Şimdilik boş.
INTRUSION_FPS_BY_CAMERA=
# YOLO çözünürlüğü: 416 düşük-spec varsayılanı. CPU %100'e yapışıyor / kameralar
# takılıyorsa 320 yap (uzaktaki kişide biraz recall kaybı olur).
YOLO_INFERENCE_SIZE=416
# GPU: build CPU-only olduğu için "auto" pratikte CPU demektir (4GB Nvidia
# kullanılmaz — kullanmak için CUDA'lı rebuild gerekir, aşağıdaki nota bak).
USE_GPU_FOR_PERSON=auto
YOLO_PERSON_MODEL=yolov8n.pt
YOLO_PERSON_TRACKER=bytetrack.yaml
INTRUSION_CONFIDENCE=0.30
INTRUSION_COOLDOWN_SEC=30
INTRUSION_WARMUP_SEC=30
# 1 fps'te 2 ardışık kare ≈ 2 sn teyitli varlık (yanlış alarma karşı, ama çok geç değil)
INTRUSION_MIN_CONSECUTIVE_FRAMES=2
INTRUSION_FRAME_GAP_RESET_SEC=10
ZONE_ANCHOR=foot_or_center
# MOG2 hareket yedeği: en yüksek yanlış-alarm kaynağı + ekstra CPU. Kapalı kalsın.
INTRUSION_MOTION_FALLBACK_ENABLED=false

# --- Kanıt (klip + foto) --- 12GB RAM + 1TB disk rahat
INTRUSION_CLIP_ENABLED=true
# ~1 dakikalık kanıt videosu (15 sn önce + 45 sn sonra)
INTRUSION_CLIP_PRE_SEC=15
INTRUSION_CLIP_POST_SEC=45
INTRUSION_BURST_SCREENSHOTS=5
INTRUSION_CLIP_JPEG_QUALITY=70
INTRUSION_CLIP_MAX_WIDTH=960
# 1TB disk var → kanıtları 14 gün sakla (varsayılan 7). İstersen 30 yap.
INTRUSION_RETENTION_DAYS=14

# ── Genel CPU / thread ayarı (i5-8250U: 4 çekirdek) ─────────
# Tek çıkarım işçisi + ONNX iç thread'leri paralelliği sağlar (zayıf CPU'da
# fazla işçi thrash yapar). intra-op=4 → tek çıkarım tüm 4 çekirdeği kullanır.
INFERENCE_WORKERS=1
IO_WORKERS=2
ONNX_INTRA_OP_THREADS=4
ONNX_INTER_OP_THREADS=1
# Modelleri açılışta yükle (eksik model/RAM sorununu erken yakalar)
PRELOAD_MODELS=true
# Plaka hattı hareket kapısı: durağan karede ALPR atla, her 10. karede zorla dene
PLATE_MOTION_GATE_ENABLED=true
PLATE_MOTION_SKIP_THRESHOLD=0.005
PLATE_MANDATORY_DETECT_EVERY_N=10

# ── Loglama ─────────────────────────────────────────────────
LOG_LEVEL=INFO
