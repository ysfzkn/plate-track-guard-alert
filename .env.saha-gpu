# ============================================================
#  GateGuard — SAHA (PROD) .env  ·  GPU (CUDA) BUILD
#  Donanım: Intel i5-8250U · 12GB RAM · 4GB Nvidia GPU (CUDA)
#  Bu env yalnızca CUDA'lı build (build-gpu.ps1) ile birlikte kullanılır.
#  Kurulumda: bu dosyayı  C:\GateGuard\.env  olarak kopyala.
#  ÖN KOŞUL: Hedef PC'de GÜNCEL Nvidia sürücüsü kurulu olmalı (CUDA toolkit
#            GEREKMEZ — CUDA kütüphaneleri torch içinde gömülü gelir).
#  <<< DOLDUR >>> yerlerini kendi bilgilerinle değiştir.
# ============================================================

MOCK_MODE=false

# ── Plaka/Bariyer Kamerası ──────────────────────────────────
RTSP_URL=rtsp://admin:SIFRE@192.168.1.100:554/cam/realmonitor?channel=1&subtype=0   # <<< DOLDUR >>>
# GPU, hırsızlık YOLO'sunu üstlendiği için CPU plaka tanımaya daha çok ayrılır → 5.
PROCESS_FPS=5
CAMERA_ENTRY_SIZE_CHANGE=recede         # <<< sahada doğrula, gerekirse approach >>>
CAMERA_ENTRY_Y_DIRECTION=down
CONFIDENCE_THRESHOLD=0.45
ALARM_COOLDOWN_SEC=60
LPR_ENGINE=fast_alpr
# Plaka dedektör çözünürlüğü: GPU rahat kaldırır → yüksek çözünürlük, tam kutu,
# kenar karakteri kırpmaz. 640 (veya en iyi doğruluk için s-608). İlk açılışta iner.
ALPR_DETECTOR_MODEL=yolo-v9-t-640-license-plate-end2end
ALPR_OCR_MODEL=cct-s-v2-global-model

# ── ESP32 Siren (opsiyonel) ─────────────────────────────────
ESP32_IP=192.168.1.50                   # <<< DOLDUR (yoksa boş) >>>
ALARM_SIREN_ENABLED=false               # <<< ESP32 varsa true >>>

# ── Moonwell MDB (ağdaki paylaşımlı PC) ─────────────────────
# UNC yolu kullan (eşlenmiş sürücü DEĞİL). GateGuard'ı paylaşımı okuyabilen bir
# kullanıcı hesabıyla çalıştır. Access Database Engine 2016 (64-bit) kurulu olmalı.
MDB_PATH=\\MOONWELL-PC\paylasim\MW305_DB200.mdb   # <<< DOLDUR >>>
MDB_COPY_LOCAL=true
SQLITE_PATH=data/gateguard.db

# ── Modül 2: Hırsızlık / Gece İzleme (7 kamera) — GPU ───────
ENABLE_INTRUSION_MODULE=true
INTRUSION_SHADOW_MODE=true              # ilk hafta true (siren çalmaz, ayar yaparsın)
NIGHT_MODE_START=22:00
NIGHT_MODE_END=07:00

# GPU'yu KULLAN: "auto" torch ile CUDA'yı algılar ve GPU'da çalışır.
# (Build CPU-only olsaydı auto pratikte CPU'ya düşerdi — bu build CUDA'lı.)
USE_GPU_FOR_PERSON=auto
YOLO_PERSON_MODEL=yolov8n.pt
YOLO_PERSON_TRACKER=bytetrack.yaml
# GPU hızlı → kamera başına 2 fps rahat kaldırır (CPU'da 1'e düşürmüştük).
INTRUSION_PROCESS_FPS=2
INTRUSION_FPS_BY_CAMERA=
# GPU native çözünürlüğü kaldırır → daha iyi recall. VRAM sıkışırsa 512/416 yap.
YOLO_INFERENCE_SIZE=640
INTRUSION_CONFIDENCE=0.30
INTRUSION_COOLDOWN_SEC=30
INTRUSION_WARMUP_SEC=30
# 2 fps'te 3 ardışık kare ≈ 1.5 sn teyitli varlık
INTRUSION_MIN_CONSECUTIVE_FRAMES=3
INTRUSION_FRAME_GAP_RESET_SEC=10
ZONE_ANCHOR=foot_or_center
INTRUSION_MOTION_FALLBACK_ENABLED=false

# --- Kanıt (klip + foto) --- 12GB RAM + 1TB disk
INTRUSION_CLIP_ENABLED=true
# ~1 dakikalık kanıt videosu (15 sn önce + 45 sn sonra)
INTRUSION_CLIP_PRE_SEC=15
INTRUSION_CLIP_POST_SEC=45
INTRUSION_BURST_SCREENSHOTS=5
INTRUSION_CLIP_JPEG_QUALITY=75
INTRUSION_CLIP_MAX_WIDTH=1280
INTRUSION_RETENTION_DAYS=14

# ── CPU / thread (fast_alpr hâlâ CPU'da; YOLO GPU'da) ───────
INFERENCE_WORKERS=1
IO_WORKERS=2
ONNX_INTRA_OP_THREADS=4
ONNX_INTER_OP_THREADS=1
PRELOAD_MODELS=true
PLATE_MOTION_GATE_ENABLED=true
PLATE_MOTION_SKIP_THRESHOLD=0.005
PLATE_MANDATORY_DETECT_EVERY_N=10

LOG_LEVEL=INFO
