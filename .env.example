# ============================================================
#  GateGuard Configuration
#  Copy this file to .env and edit the values.
#  cp .env.example .env
# ============================================================

# ── Auth ────────────────────────────────────────────────────
# Kullanıcı adı + parola tabanlı oturum sistemi. .env'de ekstra ayar
# gerekmiyor. İlk başlatmada otomatik 'admin' kullanıcısı yaratılır,
# parola data/initial_admin_password.txt dosyasına yazılır VE konsola basılır.
# İlk girişten sonra admin parolayı değiştirmek zorundadır.

# ── Camera ──────────────────────────────────────────────────
# RTSP URL of the IP camera pointed at the gate.
# TIP: if a camera "connects but shows no image", its MAIN stream is usually
# H.265/HEVC (OpenCV can't decode) — use the SUB-STREAM (lower-res H.264) URL.
# Hikvision sub: .../Streaming/Channels/102   Dahua sub: .../cam/realmonitor?channel=1&subtype=1
RTSP_URL=rtsp://admin:password@192.168.1.100:554/Streaming/Channels/101
# OpenCV/FFmpeg RTSP options (forces TCP + timeout; fixes most no-image cases).
# Override only if a camera needs different transport/options.
# OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|timeout;8000000|max_delay;500000

# ── ESP32 Alarm Module ──────────────────────────────────────
# IP address of the ESP32 running esp32_relay.ino
ESP32_IP=192.168.1.50

# ── Databases ───────────────────────────────────────────────
# Path to the Moonwell MW-305 Access database (read-only).
#
# LOCAL örnek:
#   MDB_PATH=moonwel_db/MW305_DB200.mdb
#
# AĞDAKI BAŞKA PC örneği (Moonwell başka bir bilgisayarda) — UNC yolu kullanın:
#   MDB_PATH=\\MOONWELL-PC\paylasim\moonwell\MW305_DB200.mdb
#   • UNC yolu kullanın (\\PC-ADI\...). Eşlenmiş sürücü harfi (Z:\) KULLANMAYIN;
#     servis/oturum o harfi göremez.
#   • GateGuard'ı bu paylaşımı OKUYABİLEN bir kullanıcı hesabıyla çalıştırın
#     (Windows servisi "Local System" ağ paylaşımına erişemez → bir kullanıcı/
#     domain hesabı seçin).
#   • Moonwell PC'sinde klasörü "Paylaş" → bu PC'nin hesabına en az OKUMA izni.
#   • Access ODBC sürücüsü (Microsoft Access Driver *.mdb, *.accdb) Python ile
#     aynı bitlikte (64-bit) kurulu olmalı.
MDB_PATH=moonwel_db/MW305_DB200.mdb

# Ağdaki .mdb'yi açmadan önce yerel geçici dosyaya kopyala (ağ paylaşımı için
# ÖNERİLİR). Kilit dosyası (.ldb) izin sorununu ve anlık ağ kopmalarını önler.
# Sadece OKUMA izni yeterli olur. Yerel dosyada gereksizse false yapabilirsiniz.
MDB_COPY_LOCAL=true

# Local SQLite database (auto-created on first run)
SQLITE_PATH=data/gateguard.db

# ── Screenshots ─────────────────────────────────────────────
SCREENSHOT_DIR=static/screenshots

# ── Detection ───────────────────────────────────────────────
# false = Live mode (real camera + ESP32)
# true  = Test mode (fake camera, no hardware needed)
MOCK_MODE=false

# Frames analyzed per second on the PLATE camera. Higher = more chances to
# catch a fast-passing vehicle in a readable frame. The plate cam is a single
# stream (fast-alpr ~30ms/frame on CPU) so 5 is affordable and noticeably
# improves recall for fast / brief passes. Raise toward 8 if cars enter fast.
PROCESS_FPS=5

# Minimum per-frame confidence to accept a plate reading (0.0-1.0)
CONFIDENCE_THRESHOLD=0.45

# Seconds before the same plate can trigger another alarm
ALARM_COOLDOWN_SEC=60

# Levenshtein distance tolerance for fuzzy DB lookup (0=exact only)
FUZZY_TOLERANCE=1

# ── Track-based multi-frame consensus ──────────────────────
# A passage is committed only after the vehicle leaves the view.
# Minimum valid OCR readings required before committing a passage.
MIN_FRAMES_FOR_COMMIT=2
# Fast-pass recovery: commit on a SINGLE reading if its confidence >= this.
# A fast car may be readable in only one frame; a >=0.90 read is trustworthy
# alone, while low-confidence night guesses (~0.5-0.6, inconsistent) stay
# dropped so we never log a hallucinated plate. Lower only with caution.
COMMIT_SINGLE_CONF=0.90
# Consecutive missed frames before a track finalizes.
TRACK_IDLE_FRAMES=2
# Force-close tracks that exceed this duration (seconds).
TRACK_MAX_DURATION_SEC=15
# Bbox IoU required to associate a detection with an active track.
TRACK_IOU_THRESHOLD=0.2
# Fuzzy plate text tolerance for cross-frame association (handles OCR variance).
TRACK_FUZZY_TOLERANCE=2
# One vehicle = one passage: tracks of the same (fuzzy) plate finalizing within
# this many seconds are merged into ONE record (ramp motion + OCR variance can
# fragment a single car into many tracks). A genuine re-entry after this window
# is a new passage. Direction is a frame-weighted vote across the fragments.
PASSAGE_DEDUP_SEC=30
# Minimum bbox area ratio to classify direction by size change.
DIRECTION_AREA_RATIO=1.2

# ── LPR Engine ──────────────────────────────────────────────
# "fast_alpr"    — Best accuracy (96%). Built-in detector + OCR. Recommended.
# "yolo_easyocr" — Custom YOLO plate detector + EasyOCR. Needs trained weights.
# "easyocr"      — OpenCV contours + EasyOCR. No extra setup. Low accuracy.
LPR_ENGINE=fast_alpr

# Only needed if LPR_ENGINE=yolo_easyocr
YOLO_WEIGHTS=models/plate_detector.pt

# ── Entry/Exit direction detection (single camera) ─────────
# Primary signal: bbox area change
#   "approach" = plate growing (vehicle approaching camera) = ENTRY
#                Typical gate camera looking outward at arrivals.
#   "recede"   = plate shrinking (vehicle moving away) = ENTRY
#                Camera inside the lot looking at the entrance — vehicles entering
#                pass the camera and drive away into the parking area.
# D-1 garage-ramp camera: entering cars DESCEND away from the camera (plate
# shrinks) → "recede". Verified on the sample clips (entering car area_ratio≈0.6).
CAMERA_ENTRY_SIZE_CHANGE=recede

# Fallback when area change is ambiguous (< ratio threshold):
#   "down" = plate moving DOWN in frame = ENTRY
#   "up"   = plate moving UP in frame = ENTRY
CAMERA_ENTRY_Y_DIRECTION=down

# ── Module 2: Intrusion / Hırsızlık Tespiti ──────────────
# Enable the multi-camera person detection module.
# Cameras themselves are registered via web UI and stored in the database
# (not configured here). This is just the feature toggle.
ENABLE_INTRUSION_MODULE=false

# Night mode: used by zones marked "night only" (is_night_only=1).
# Outside this window those zones do not trigger alarms.
NIGHT_MODE_START=22:00
NIGHT_MODE_END=07:00

# Detection thresholds — tuned for high recall + low false-positive.
# Lower per-frame confidence is paired with a frame-count consensus rule:
# alarm fires only after the same track is seen in N consecutive frames,
# so single-frame flicker (shadow, glint, mannequin) cannot trigger.
INTRUSION_CONFIDENCE=0.30
INTRUSION_MIN_LOITER_SEC=1
INTRUSION_COOLDOWN_SEC=30
INTRUSION_PROCESS_FPS=2
# Per-camera FPS override "camId:fps,..." — run vegetation/low-priority cameras
# slower to stay within the single-worker CPU budget on a many-camera site.
# Example for the prod set (D-9/12/15/16 are vegetation-heavy): "1:2,9:1,12:1,15:1,16:1"
INTRUSION_FPS_BY_CAMERA=
INTRUSION_WARMUP_SEC=30
# Frame-count consensus (3 frames @ 2 FPS ≈ 1.5 s of confirmed presence)
INTRUSION_MIN_CONSECUTIVE_FRAMES=3
# If gap between observations exceeds this, the counter resets
INTRUSION_FRAME_GAP_RESET_SEC=3.0

# Zone membership anchor:
#   "foot_or_center" (default) = person matches if FOOT or BODY-CENTER is in the
#      zone. Catches zones drawn on the GROUND (foot) AND on a WALL/DOOR (center),
#      while people beyond a perimeter fence stay out (both points outside).
#   "foot"   = ground contact only (strict; misses wall/door-drawn zones).
#   "center" = legacy bbox center.
ZONE_ANCHOR=foot_or_center
# MOG2 motion fallback (catches occluded/climbing intruders YOLO misses) is the
# highest false-positive component (fires on swaying vegetation/shadows) and
# costs an extra inference/frame. Default OFF; enable per-zone only for specific
# low-vegetation wall/climb zones (zone flag enable_motion_fallback=1).
INTRUSION_MOTION_FALLBACK_ENABLED=false

# Shadow mode: log events to DB without triggering the physical siren.
# Recommended for the first week of deployment to tune parameters.
INTRUSION_SHADOW_MODE=true

# Person detection model (auto-downloaded by ultralytics on first run).
# A .pt runs via torch on CPU. If you export an ONNX model (scripts/export_onnx.py)
# you can point this at yolov8n.onnx — the system auto-detects it and falls back
# to the .pt if the .onnx is missing.
YOLO_PERSON_MODEL=yolov8n.pt
YOLO_PERSON_TRACKER=bytetrack.yaml
# "auto" detects CUDA and falls back to CPU. On a GPU-less box this is just CPU.
# NOTE: a "+cpu" torch build (the default here) CANNOT use CUDA even if you have
# a GPU. Leave this "auto" (or "false"). If you set "true" with a CPU-only torch
# the code now auto-falls-back to CPU (older builds crashed → silent 0 detections).
USE_GPU_FOR_PERSON=auto
# YOLO inference size (long edge px). 416 is the low-spec default (~2.4x faster
# than 640 on CPU). Use 320 only if still too slow (hurts distant-person recall).
YOLO_INFERENCE_SIZE=416

# Evidence capture: video clip + burst screenshots
INTRUSION_CLIP_ENABLED=true
# Pre/post buffer seconds. Lower on low-RAM boxes — the ring buffer holds
# pre_sec*fps frames PER CAMERA (JPEG-encoded, see quality/width below).
INTRUSION_CLIP_PRE_SEC=6
INTRUSION_CLIP_POST_SEC=4
INTRUSION_CLIP_DIR=static/intrusion_clips
INTRUSION_BURST_SCREENSHOTS=5
# Retention window (days) for screenshots, intrusion clips and test_outputs.
# Files older than this are auto-deleted hourly + on startup. Default 7 days.
INTRUSION_RETENTION_DAYS=7
# Ring-buffer frames are JPEG-encoded + downscaled to keep RAM low.
INTRUSION_CLIP_JPEG_QUALITY=70
INTRUSION_CLIP_MAX_WIDTH=960

# ── Performance / low-spec CPU tuning ───────────────────────
# Shared bounded thread pools (see app/inference_pool.py).
# INFERENCE_WORKERS=1 is right for most boxes (person detection is already
# serialized + ONNX threads give the parallelism). Bump on 6+ physical cores.
INFERENCE_WORKERS=1
IO_WORKERS=2
# ONNX Runtime / BLAS threads. intra-op=3 on a 4-core box leaves a core free.
ONNX_INTRA_OP_THREADS=3
ONNX_INTER_OP_THREADS=1
# Load ML models at startup (fail fast on missing weights / OOM) vs lazily.
PRELOAD_MODELS=true
# Motion-gate the plate pipeline: skip ALPR on static frames, force a detection
# every Nth frame so a slow-approaching vehicle / lighting drift isn't missed.
PLATE_MOTION_GATE_ENABLED=true
PLATE_MOTION_SKIP_THRESHOLD=0.005
PLATE_MANDATORY_DETECT_EVERY_N=10
# Motion fallback: score human-likeness on NET displacement + directionality
# (rejects jittery in-place blobs like swaying branches). Set false for legacy.
MOTION_USE_NET_DISPLACEMENT=true

# ── General ─────────────────────────────────────────────────
LOG_LEVEL=INFO
